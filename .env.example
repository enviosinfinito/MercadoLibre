APP_NAME=SaaS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Host ports for docker compose (avoid clashes with other local stacks).
APP_PORT=8082
FORWARD_DB_PORT=3307
FORWARD_REDIS_PORT=6380
APP_URL=http://localhost:8082
# Public URL for shareable links (connection invites). Leave empty to auto-use
# the Cloudflare/ngrok host from MELI_REDIRECT_URI when present.
# Prefer a reserved ngrok domain (paid): https://YOUR_SUBDOMAIN.ngrok-free.app
APP_PUBLIC_URL=
# Used by scripts/dev-tunnel.sh for a stable hostname across restarts.
NGROK_DOMAIN=
# Calendar day for reports/filters (timestamps stay UTC in DB).
APP_BUSINESS_TIMEZONE=America/Mexico_City

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
# Host tools use FORWARD_DB_PORT; compose sets DB_HOST=mysql / DB_PORT=3306 in containers.
DB_PORT=3307
DB_DATABASE=saas
DB_USERNAME=saas
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
# Host tools use FORWARD_REDIS_PORT; compose sets REDIS_HOST=redis / REDIS_PORT=6379 in containers.
REDIS_PORT=6380

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@saas.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=minio123
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=saas
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_URL=http://localhost:9000/saas

VITE_APP_NAME="${APP_NAME}"

REVERB_APP_ID=saas
REVERB_APP_KEY=saas-key
REVERB_APP_SECRET=saas-secret
# Browser / Vite (host machine). Docker Compose overrides REVERB_HOST=reverb
# and REVERB_PORT=8080 on app/horizon so PHP can publish into the reverb service.
REVERB_HOST=localhost
REVERB_PORT=8081
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8081
VITE_REVERB_SCHEME=http

MELI_CLIENT_ID=
MELI_CLIENT_SECRET=
MELI_REDIRECT_URI="${APP_URL}/oauth/mercadolibre/callback"
MELI_APP_ID=
MELI_AUTH_BASE_URL=https://auth.mercadolibre.com.mx
MELI_API_BASE_URL=https://api.mercadolibre.com
MELI_WEBHOOKS_STUB=true
# Optional shared secret: register callback as .../webhooks/mercadolibre?secret=VALUE
MELI_WEBHOOK_SECRET=
# Mercado Pago report APIs (seller ML OAuth token reused)
MERCADOPAGO_API_BASE_URL=https://api.mercadopago.com
FINANCE_CASH_DIFF_TOLERANCE=0.01

AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
AMAZON_AWS_ACCESS_KEY=
AMAZON_AWS_SECRET_KEY=
AMAZON_ROLE_ARN=
AMAZON_SQS_QUEUE_URL=
AMAZON_MARKETPLACE_ID=A1AM78C64UM0Y8

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
CASHIER_CURRENCY=mxn

SENTRY_LARAVEL_DSN=

HORIZON_PATH=horizon
PULSE_ENABLED=true
TELESCOPE_ENABLED=true
TELESCOPE_MAX_STORAGE_MB=500

DIAGNOSTIC_HTTP_LOGGING_MINUTES=10

# Returns hybrid message analysis (local rules first; AI only when confidence is low)
RETURNS_AI_ENABLED=false
RETURNS_AI_PROVIDER=openai
RETURNS_AI_MODEL=gpt-4o-mini
RETURNS_AI_API_KEY=
RETURNS_AI_BASE_URL=https://api.openai.com/v1

# SlideOver panel widths (% of viewport, desktop)
SLIDE_OVER_WIDTH_PERCENT=45
SLIDE_OVER_NESTED_STEP_PERCENT=5
SLIDE_OVER_MIN_WIDTH_PERCENT=30
